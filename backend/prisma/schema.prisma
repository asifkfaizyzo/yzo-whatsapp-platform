generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// SuperAdmin Model
model SuperAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  refreshTokens RefreshToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// Tenant Model
model Tenant {
  id          String   @id @default(cuid())
  tenantName  String
  email       String   @unique
  password    String
  phone       String?
  address     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]   // ← one tenant can have many refresh tokens

  users       User[]
}


// User Model
model User {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  email      String   @unique
  password   String
  
  isActive     Boolean  @default(true)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  refreshTokens RefreshToken[]   // ← one user can have many refresh tokens

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


// Refresh Token Model
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @db.Text

  // ─── Who owns this token ───
  // Either tenantId OR userId will be set
  // NOT both at the same time

  tenantId  String?  // ← nullable (optional)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  userId    String?  // ← nullable (optional)
  user      User?    @relation(fields: [userId], references: [id])

 superAdminId String?     
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])


  // ─── Token Info ───
  expiresAt DateTime  // ← when does it expire
  isRevoked Boolean   @default(false) // ← is it still valid
  createdAt DateTime  @default(now())
}

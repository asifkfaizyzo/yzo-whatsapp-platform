generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



//──────────────────Model SuperAdmin──────────────────
model SuperAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  refreshTokens RefreshToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



//─────────────────enum TenantStatus───────────────────
enum TenantStatus {
  PENDING
  APPROVED
  BLOCKED
}



//──────────────────Model Tenant──────────────────
model Tenant {
  id          String   @id @default(cuid())
  tenantName  String
  email       String   @unique
  password    String
  phone       String?
  address     String?
  
   whatsappPhoneId     String?  
   whatsappWabaId      String?  
   whatsappAccessToken String?  
   whatsappVerifyToken String?  @default("yzo_default_verification_token")
  
   status      TenantStatus @default(PENDING)
   isActive    Boolean   @default(true) 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]   // ← one tenant can have many refresh tokens
   tags        Tag[]              
  userTagMappings UserTagMapping[]

  users       User[]
  contacts      Contact[]  
}



//──────────────────Model User──────────────────
model User {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  email      String   @unique
  password   String

  assignedContacts Contact[] @relation("UserAssignedContacts")
  
  isActive     Boolean  @default(true)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  refreshTokens RefreshToken[]   // ← one user can have many refresh tokens
    userTags   UserTagMapping[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



//──────────────────Model RefreshToken──────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @db.Text

  // ─── Who owns this token ───
  // Either tenantId OR userId will be set
  // NOT both at the same time

  tenantId  String?  // ← nullable (optional)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  userId    String?  // ← nullable (optional)
  user      User?    @relation(fields: [userId], references: [id])

 superAdminId String?     
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])


  // ─── Token Info ───
  expiresAt DateTime  // ← when does it expire
  isRevoked Boolean   @default(false) // ← is it still valid
  createdAt DateTime  @default(now())
}



//──────────────────PasswordReset Model────────────────── 
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
    token     String   @unique @default("")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}



//──────────────────Model Contact──────────────────
model Contact {
  id          String   @id @default(cuid())

  // ─── Basic Info ───
  name        String
  phone       String
  email       String?
  company     String?

  // Link to Tag model
  contactTags ContactTagMapping[]

  // ─── WhatsApp ───
  countryCode String   @default("+91")
  whatsappId  String?

  // ─── Status ───
  isActive    Boolean  @default(true)
  isBlocked   Boolean  @default(false)

  // ─── Belongs to Tenant ───
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  assignedTo  String?  
  assignedAt  DateTime? 

  assignedUser User? @relation("UserAssignedContacts",fields: [assignedTo],references: [id])

  conversations Conversation?  

  // ─── Timestamps ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phone, tenantId])
  @@index([assignedTo])      
  @@index([tenantId])
}



//────────────New Tag Model────────────
model Tag {
  id          String   @id @default(cuid())
  name        String   // "VIP", "Hot Lead", "General", "Support"
  priority    Int      // 1 = Highest, 2, 3, 4 = Lowest
  description String?  // Optional: describe the tag

  // ─── Belongs to Tenant ───
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  // ─── Relations ───
  contactTags ContactTagMapping[]  // Which contacts have this tag
  userTags    UserTagMapping[]     // Which users handle this tag

  // ─── Timestamps ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, tenantId])  // Tag names are unique per tenant
  @@index([tenantId])
  @@index([priority])
}



//────────────Contact ↔ Tag Mapping────────────
model ContactTagMapping {
  id        String  @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contactId, tagId])  // A contact can't have the same tag twice
}



//──────────── Tag Mapping (This is the KEY to priority assignment)────────────
model UserTagMapping {
  id     String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id])

  // ─── Belongs to Tenant ───
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, tagId])  // A user can't be mapped to the same tag twice
  @@index([tagId])
  @@index([userId])
}



//──────Model Conversation──────
model Conversation {
  id        String    @id @default(cuid())
  contactId String    @unique  // One conversation per contact (simplest)
  tenantId  String

  contact   Contact   @relation(fields: [contactId], references: [id])
  status String @default("OPEN")
  // OPEN, RESOLVED, CLOSED

   assignedTo    String?   // agentId

  reopenCount   Int       @default(0)
  resolvedAt    DateTime?
  closedAt      DateTime?
  reopenedAt    DateTime?
  lastMessageAt DateTime?

  messages  Message[]
  activities    ConversationActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([contactId])
  @@index([tenantId, status])
}



//──────Model Message──────
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String?      // Agent ID (null = sent by contact/customer)
  senderType     String      

  text           String
  type           String @default ("TEXT") // TEXT, IMAGE, FILE
  isRead         Boolean  @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderType]) 
}



//──────Model ConversationActivity──────
model ConversationActivity {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  action          String
  // opened, resolved, closed, auto_reopened

  performedBy     String?      // agentId or null
  performedByType String?      // agent, system, contact

  reason          String?

  createdAt       DateTime     @default(now())

  @@index([conversationId])
}



//──────Model autoReopen──────
model AutoReopenConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique

  enabled            Boolean  @default(true)
  reopenWindowHours  Int      @default(72)
  maxReopenCount     Int      @default(5)
  smartFilterEnabled Boolean  @default(true)

  assignmentStrategy String   @default("original_agent")
  // original_agent, unassigned_pool

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
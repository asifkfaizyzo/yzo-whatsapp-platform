generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// SuperAdmin Model
model SuperAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  refreshTokens RefreshToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum TenantStatus {
  PENDING
  APPROVED
  BLOCKED
}




// Tenant Model
model Tenant {
  id          String   @id @default(cuid())
  tenantName  String
  email       String   @unique
  password    String
  phone       String?
  address     String?
  
   status      TenantStatus @default(PENDING)
   isActive    Boolean   @default(true) 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]   // ← one tenant can have many refresh tokens

  users       User[]
  contacts      Contact[]  
}


// User Model
model User {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  email      String   @unique
  password   String
  
  isActive     Boolean  @default(true)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  refreshTokens RefreshToken[]   // ← one user can have many refresh tokens

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


// Refresh Token Model
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @db.Text

  // ─── Who owns this token ───
  // Either tenantId OR userId will be set
  // NOT both at the same time

  tenantId  String?  // ← nullable (optional)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  userId    String?  // ← nullable (optional)
  user      User?    @relation(fields: [userId], references: [id])

 superAdminId String?     
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])


  // ─── Token Info ───
  expiresAt DateTime  // ← when does it expire
  isRevoked Boolean   @default(false) // ← is it still valid
  createdAt DateTime  @default(now())
}



// PasswordReset Model
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
    token     String   @unique @default("")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}



model Contact {
  id          String   @id @default(cuid())

  // ─── Basic Info ───
  name        String
  phone       String
  email       String?
  company     String?
  tags        String[]

  // ─── WhatsApp ───
  countryCode String   @default("+91")
  whatsappId  String?

  // ─── Status ───
  isActive    Boolean  @default(true)
  isBlocked   Boolean  @default(false)

  // ─── Belongs to Tenant ───
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  assignedTo  String?  
  assignedAt  DateTime? 

  conversations Conversation?  

  // ─── Timestamps ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phone, tenantId])
  @@index([assignedTo])      
  @@index([tenantId])
}



model Conversation {
  id        String    @id @default(cuid())
  contactId String    @unique  // One conversation per contact (simplest)
  tenantId  String
  contact   Contact   @relation(fields: [contactId], references: [id])
  status String @default("OPEN")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([contactId])
}



model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String?      // Agent ID (null = sent by contact/customer)
  text           String
  type           String @default ("TEXT") // TEXT, IMAGE, FILE
  isRead         Boolean  @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}
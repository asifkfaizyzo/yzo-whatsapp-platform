generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



//──────────────────Model SuperAdmin──────────────────
model SuperAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  refreshTokens RefreshToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



//─────────────────enum TenantStatus───────────────────
enum TenantStatus {
  PENDING
  APPROVED
  BLOCKED
}



//──────────────────Model Tenant──────────────────
model Tenant {
  id          String   @id @default(cuid())
  tenantName  String
  email       String   @unique
  password    String
  phone       String?
  address     String?
  
   whatsappPhoneId     String?  
   whatsappWabaId      String?  
   whatsappAccessToken String?  
   whatsappVerifyToken String?  @default("yzo_default_verification_token")
  
   status      TenantStatus @default(PENDING)
   isActive    Boolean   @default(true) 

  planId      String?
  plan        SubscriptionPlan? @relation("TenantSubscription", fields: [planId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]   // ← one tenant can have many refresh tokens
   tags        Tag[]              
  userTagMappings UserTagMapping[]

  users       User[]
  contacts      Contact[]

  templates   Template[]
  broadcasts  Broadcast[]
}



//──────────────────Model User──────────────────
model User {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  email      String   @unique
  password   String

  createdTemplates Template[]
  createdBroadcasts Broadcast[]

  assignedContacts Contact[] @relation("UserAssignedContacts")
  
  isActive     Boolean  @default(true)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  refreshTokens RefreshToken[]   // ← one user can have many refresh tokens
    userTags   UserTagMapping[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



//──────────────────Model RefreshToken──────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @db.Text

  // ─── Who owns this token ───
  // Either tenantId OR userId will be set
  // NOT both at the same time

  tenantId  String?  // ← nullable (optional)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  userId    String?  // ← nullable (optional)
  user      User?    @relation(fields: [userId], references: [id])

 superAdminId String?     
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])


  // ─── Token Info ───
  expiresAt DateTime  // ← when does it expire
  isRevoked Boolean   @default(false) // ← is it still valid
  createdAt DateTime  @default(now())
}



//──────────────────PasswordReset Model────────────────── 
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
    token     String   @unique @default("")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}



//──────────────────Model Contact──────────────────
model Contact {
  id          String   @id @default(cuid())

  // ─── Basic Info ───
  name        String
  phone       String
  email       String?
  company     String?

  // Link to Tag model
  contactTags ContactTagMapping[]

  // ─── WhatsApp ───
  countryCode String   @default("+91")
  whatsappId  String?

  // ─── Status ───
  isActive    Boolean  @default(true)
  isBlocked   Boolean  @default(false)

  // ─── Belongs to Tenant ───
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  broadcastRecipients BroadcastRecipient[]

  assignedTo  String?  
  assignedAt  DateTime? 

  assignedUser User? @relation("UserAssignedContacts",fields: [assignedTo],references: [id])

  conversations Conversation?  

  // ─── Timestamps ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phone, tenantId])
  @@index([assignedTo])      
  @@index([tenantId])
}



//────────────New Tag Model────────────
model Tag {
  id          String   @id @default(cuid())
  name        String   // "VIP", "Hot Lead", "General", "Support"
  priority    Int      // 1 = Highest, 2, 3, 4 = Lowest
  description String?  // Optional: describe the tag

  // ─── Belongs to Tenant ───
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  // ─── Relations ───
  contactTags ContactTagMapping[]  // Which contacts have this tag
  userTags    UserTagMapping[]     // Which users handle this tag

  broadcastTags BroadcastTag[]

  // ─── Timestamps ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, tenantId])  // Tag names are unique per tenant
  @@index([tenantId])
  @@index([priority])
}



//────────────Contact ↔ Tag Mapping────────────
model ContactTagMapping {
  id        String  @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contactId, tagId])  // A contact can't have the same tag twice
}



//──────────── Tag Mapping (This is the KEY to priority assignment)────────────
model UserTagMapping {
  id     String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id])

  // ─── Belongs to Tenant ───
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, tagId])  // A user can't be mapped to the same tag twice
  @@index([tagId])
  @@index([userId])
}



//──────Model Conversation──────
model Conversation {
  id        String    @id @default(cuid())
  contactId String    @unique  // One conversation per contact (simplest)
  tenantId  String

  contact   Contact   @relation(fields: [contactId], references: [id])
  status String @default("OPEN")
  // OPEN, RESOLVED, CLOSED

   assignedTo    String?   // agentId

  reopenCount   Int       @default(0)
  resolvedAt    DateTime?
  closedAt      DateTime?
  reopenedAt    DateTime?
  lastMessageAt DateTime?

  messages  Message[]
  activities    ConversationActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([contactId])
  @@index([tenantId, status])
}



//──────Model Message──────
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String?      // Agent ID (null = sent by contact/customer)
  senderType     String      

  text           String
  type           String @default ("TEXT") // TEXT, IMAGE, FILE
  isRead         Boolean  @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderType]) 
}



//──────Model ConversationActivity──────
model ConversationActivity {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  action          String
  // opened, resolved, closed, auto_reopened

  performedBy     String?      // agentId or null
  performedByType String?      // agent, system, contact

  reason          String?

  createdAt       DateTime     @default(now())

  @@index([conversationId])
}



//──────Model autoReopen──────
model AutoReopenConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique

  enabled            Boolean  @default(true)
  reopenWindowHours  Int      @default(72)
  maxReopenCount     Int      @default(5)
  smartFilterEnabled Boolean  @default(true)

  assignmentStrategy String   @default("original_agent")
  // original_agent, unassigned_pool

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}



//──────────────────enum PlanStatus──────────────────
enum PlanStatus {
  ACTIVE
  INACTIVE
}



//──────────────────Model SubscriptionPlan──────────────────
model SubscriptionPlan {
  id           String     @id @default(cuid())
  name         String     @unique
  description  String?

  monthlyPrice Float
  annualPrice  Float?

  status       PlanStatus @default(ACTIVE)

  // ─── Usage Limits (null = unlimited) ───
  maxAgents      Int
  maxBroadcasts  Int?
  maxAutomations Int?
  maxCampaigns   Int?
  maxApiCalls    Int?
  maxAiCredits   Int?

  // ─── Relations ───
  features     PlanFeature[]
  integrations PlanIntegration[]
  tenants      Tenant[]   @relation("TenantSubscription")

  // ─── Timestamps ───
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}



//──────────────────Model Feature──────────────────
model Feature {
  id    String @id @default(cuid())
  name  String @unique

  // ─── Relations ───
  plans PlanFeature[]

  // ─── Timestamps ───
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



//──────────────────Plan ↔ Feature Mapping──────────────────
model PlanFeature {
  id        String           @id @default(cuid())

  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  featureId String
  feature   Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
}



//──────────────────Model PlanIntegration──────────────────
model PlanIntegration {
  id     String           @id @default(cuid())
  name   String

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planId, name])
  @@index([planId])
enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT           // Created locally, not submitted to Meta
  PENDING         // Submitted to Meta, awaiting review
  APPROVED        // Approved by Meta, ready to use
  REJECTED        // Rejected by Meta
  PAUSED          // Paused by Meta (quality issues)
  DISABLED        // Disabled by Meta
  DELETED         // Soft deleted
}

enum BroadcastTarget {
  ALL
  TAGS
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PROCESSING     // Currently sending
  PAUSED         // Manually paused mid-send
  COMPLETED      // All messages attempted
  CANCELLED
  FAILED         // System error
}

enum MessageStatus {
  PENDING         // Not yet sent to Meta
  SENT            // Accepted by Meta API
  DELIVERED       // Delivered to user's phone
  READ            // User opened/read
  FAILED          // Failed to send
}

// ============================================
// TEMPLATE MANAGEMENT
// ============================================

model Template {
  id              String           @id @default(cuid())
  
  // Multi-tenancy
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  
  // Meta-synced fields
  metaTemplateId  String?          @unique  // ID returned by Meta after approval
  name            String           // must be lowercase, underscores only for Meta
  language        String           @default("en_US")
  category        TemplateCategory
  status          TemplateStatus   @default(DRAFT)
  
  // Template structure
  components      Json             // Full Meta components array: body text, headers, buttons
  
  // Parameter metadata (for UI rendering)
  headerParams    Int              @default(0)  // count of {{n}} in header
  bodyParams      Int              @default(0)  // count of {{n}} in body
  
  // Meta rejection reason
  rejectedReason  String?
  
  // Quality tracking
  qualityScore    String?          // GREEN, YELLOW, RED from Meta
  
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastSyncedAt    DateTime?

  broadcasts      Broadcast[]
  
  @@unique([name, language, tenantId])  // Meta requires unique name+language, unique per tenant
  @@index([status])
  @@index([category])
  @@index([tenantId])
}

// ============================================
// BROADCAST CAMPAIGNS
// ============================================

model Broadcast {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  name            String           // Campaign name: "Diwali Sale 2024"
  
  // Template reference
  templateId      String
  template        Template         @relation(fields: [templateId], references: [id])
  
  // Targeting
  targetType      BroadcastTarget  // ALL or TAGS
  tags            BroadcastTag[]   // Only used if targetType = TAGS
  
  // Default parameters (can be overridden per recipient)
  defaultParams   Json?
  
  // Campaign status
  status          BroadcastStatus  @default(DRAFT)
  
  // Scheduling
  scheduledAt     DateTime?        // null = send immediately
  startedAt       DateTime?
  completedAt     DateTime?
  
  // Stats (denormalized for fast queries)
  totalRecipients Int              @default(0)
  sent            Int              @default(0)
  delivered       Int              @default(0)
  read            Int              @default(0)
  failed          Int              @default(0)
  
  // Rate limiting
  batchSize       Int              @default(50)   // messages per batch
  batchDelayMs    Int              @default(1000)  // delay between batches
  
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  recipients      BroadcastRecipient[]
  
  @@index([status])
  @@index([scheduledAt])
  @@index([createdById])
  @@index([tenantId])
}

model BroadcastTag {
  broadcastId String
  tagId       String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id])
  
  @@id([broadcastId, tagId])
}

model BroadcastRecipient {
  id            String          @id @default(cuid())
  
  broadcastId   String
  broadcast     Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  
  contactId     String
  contact       Contact         @relation(fields: [contactId], references: [id])
  
  // Per-recipient custom parameters override
  params        Json?
  
  // Meta tracking
  wamid         String?         @unique  // WhatsApp Message ID from Meta
  
  // Status progression: PENDING -> SENT -> DELIVERED -> READ or FAILED
  status        MessageStatus   @default(PENDING)
  
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  errorCode     String?         // Meta error code
  errorMessage  String?         // Human-readable error
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@unique([broadcastId, contactId])  // prevent duplicate sends
  @@index([broadcastId, status])
  @@index([wamid])
  @@index([status])
}
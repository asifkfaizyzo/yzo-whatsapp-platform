generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



//──────────────────Model SuperAdmin──────────────────
model SuperAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  refreshTokens RefreshToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activatedEnterpriseLeads EnterpriseLead[]
}



//─────────────────enum TenantStatus───────────────────
enum TenantStatus {
  PENDING
  APPROVED
  BLOCKED
}



//──────────────────Model Tenant──────────────────
model Tenant {
  id          String   @id @default(cuid())
  tenantName  String?
  email       String?   @unique
  password    String?
  phone       String?
  address     String?
  firstName   String?
  lastName    String?
  websiteUrl  String?
  industry    String?
  companySize String?
  country     String?
  useCase     String?

  logo      String?
  timezone  String?  @default("Asia/Kolkata")

  isEmailVerified          Boolean   @default(false)
  otpHash                  String?
  otpExpiresAt             DateTime?

  googleId     String?  @unique
  authProvider String   @default("LOCAL") // "LOCAL" | "GOOGLE"
  
   whatsappPhoneId     String?  
   whatsappWabaId      String?  
   whatsappAccessToken String?  
   whatsappVerifyToken String?  @default("yzo_default_verification_token")
   whatsappPin         String?
  
   status      TenantStatus @default(PENDING)
   isActive    Boolean   @default(true) 
   onboardingStep      Int          @default(1)
   onboardingCompleted Boolean      @default(false)

  planId      String?
  plan        SubscriptionPlan? @relation("TenantSubscription", fields: [planId], references: [id])

  planActivatedAt DateTime?
  billingType     String?   @default("monthly") // monthly / annual
  planStatus      String?   @default("inactive") // inactive / active / expired
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]   // ← one tenant can have many refresh tokens
   tags        Tag[]              
  userTagMappings UserTagMapping[]

  users       User[]
  contacts      Contact[]

  templates   Template[]
  broadcasts  Broadcast[]
  payments        Payment[]
  tickets Ticket[]
  flows           Flow[]
  keywordTriggers  KeywordTrigger[]
  enterpriseLeads EnterpriseLead[]

  subscriptionStatus   SubscriptionStatus  @default(trialing)
  currentPlan          String?
  planPeriodStart      DateTime?
  planPeriodEnd        DateTime?
  cancelRequestedAt    DateTime?
  cancellationReason   String?
  reactivatedAt        DateTime?
  dataDeletionDate     DateTime?
  subscriptionReminders SubscriptionReminder[]
  invoices             Invoice[]
  cancellationSurvey   CancellationSurvey?
  dataDeletions        TenantDataDeletion[]

  @@index([whatsappPhoneId])
    @@index([status])
  auditLogs   AuditLog[] @relation("TenantAuditLogs")
}



//──────────────────Model User──────────────────
model User {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  email      String   @unique
  password   String

  createdTemplates Template[]
  createdBroadcasts Broadcast[]

  assignedContacts Contact[] @relation("UserAssignedContacts")
  
  isActive     Boolean  @default(true)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  refreshTokens RefreshToken[]   // ← one user can have many refresh tokens
    userTags   UserTagMapping[]
    tickets Ticket[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



//──────────────────Model RefreshToken──────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @db.Text

  // ─── Who owns this token ───
  // Either tenantId OR userId will be set
  // NOT both at the same time

  tenantId  String?  // ← nullable (optional)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  userId    String?  // ← nullable (optional)
  user      User?    @relation(fields: [userId], references: [id])

 superAdminId String?     
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])


  // ─── Token Info ───
  expiresAt DateTime  // ← when does it expire
  isRevoked Boolean   @default(false) // ← is it still valid
  createdAt DateTime  @default(now())
}



//──────────────────PasswordReset Model────────────────── 
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
    token     String   @unique @default("")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}



//──────────────────Model Contact──────────────────
model Contact {
  id          String   @id @default(cuid())

  // ─── Basic Info ───
  name        String
  phone       String
  email       String?
  company     String?

  // Link to Tag model
  contactTags ContactTagMapping[]

  // ─── WhatsApp ───
  countryCode String   @default("+91")
  whatsappId  String?

  // ─── Status ───
  isActive    Boolean  @default(true)
  isBlocked   Boolean  @default(false)

  // ─── Belongs to Tenant ───
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  broadcastRecipients BroadcastRecipient[]

  assignedTo  String?  
  assignedAt  DateTime? 

  assignedUser User? @relation("UserAssignedContacts",fields: [assignedTo],references: [id])

  conversations Conversation?  

  // ─── Timestamps ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phone, tenantId])
  @@index([assignedTo])      
  @@index([tenantId, createdAt])
}



//────────────New Tag Model────────────
model Tag {
  id          String   @id @default(cuid())
  name        String   // "VIP", "Hot Lead", "General", "Support"
  priority    Int      // 1 = Highest, 2, 3, 4 = Lowest
  description String?  // Optional: describe the tag

  // ─── Belongs to Tenant ───
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  // ─── Relations ───
  contactTags ContactTagMapping[]  // Which contacts have this tag
  userTags    UserTagMapping[]     // Which users handle this tag

  broadcastTags BroadcastTag[]

  // ─── Timestamps ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, tenantId])  // Tag names are unique per tenant
  @@index([tenantId])
  @@index([priority])
}



//────────────Contact ↔ Tag Mapping────────────
model ContactTagMapping {
  id        String  @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contactId, tagId])  // A contact can't have the same tag twice
}



//──────────── Tag Mapping (This is the KEY to priority assignment)────────────
model UserTagMapping {
  id     String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id])

  // ─── Belongs to Tenant ───
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, tagId])  // A user can't be mapped to the same tag twice
  @@index([tagId])
  @@index([userId])
}



//──────Model Conversation──────
model Conversation {
  id        String    @id @default(cuid())
  contactId String    @unique  // One conversation per contact (simplest)
  tenantId  String

  contact   Contact   @relation(fields: [contactId], references: [id])
  status String @default("OPEN")
  // OPEN, RESOLVED, CLOSED

  assignedTo    String?   // agentId
  reopenCount   Int       @default(0)
  resolvedAt    DateTime?
  closedAt      DateTime?
  reopenedAt    DateTime?
  lastMessageAt DateTime?

  unreadCount   Int       @default(0)

   // ── Archive ── 
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archivedBy    String?   // userId or tenantId who archived
  archivedByRole String?  // "TENANT" | "USER"

  mode          ConversationMode  @default(BOT)
  currentFlowId String?
  currentFlow   Flow?    @relation("ConversationFlow", fields: [currentFlowId], references: [id])
  currentNodeId String?
  flowData      Json?    @default("{}")
  botPaused     Boolean  @default(false)

  // ── Analytics Timestamps ──
  incomingAt       DateTime?
  firstResponseAt  DateTime?

  messages  Message[]
  activities    ConversationActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([contactId])
  @@index([tenantId, status])
  @@index([tenantId, isArchived])
  @@index([tenantId, mode])
  @@index([currentFlowId])
}



//──────Model Message──────
enum MessageType {
  TEXT
  IMAGE
  FILE
  VIDEO
  AUDIO
  INTERACTIVE_BUTTONS
  LOCATION 
}

enum SenderType {
  SUPER_ADMIN
  TENANT
  USER  
  CONTACT
  SYSTEM
}

enum MessageDirection {
  INBOUND       // contact → platform
  OUTBOUND      // platform → contact
}


model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // ── Sender ──
  senderId       String?          // null if contact
  senderType     SenderType       // SUPER_ADMIN / TENANT / AGENT / CONTACT / SYSTEM

  // ── Direction ──
  direction      MessageDirection @default(OUTBOUND)

  // ── Content ──
  text           String?          // optional (media messages may have no text)
  type           MessageType      @default(TEXT)

  // ── Media ──
  mediaUrl       String?          // local file path
  mediaName      String?          // original filename
  mediaSize      Int?             // bytes
  mediaMimeType  String?          // image/jpeg, application/pdf
  caption        String?          // optional caption
  // ── Interactive Buttons ──
  buttons        Json?            // Array of { id, title } for INTERACTIVE_BUTTONS type
  // ── NEW: Location fields ──────────────────────
  locLatitude    Float?
  locLongitude   Float?
  locName        String?
  locAddress     String?

  // ── Status ──
  isRead         Boolean          @default(false)
  status         String       @default("sent") 

  // ── Analytics & Webhook Receipts ──
  wamid          String?          @unique
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  failureCode    Int?
  failureReason  String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderType])
  @@index([direction])

   // ── Soft Delete ──
  isDeleted      Boolean          @default(false)
  deletedAt      DateTime?
  deletedBy      String?          // id of who deleted
  deletedByRole  String?          // "TENANT" | "AGENT"
}



//──────Model ConversationActivity──────
model ConversationActivity {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  action          String
  // opened, resolved, closed, auto_reopened

  performedBy     String?      // agentId or null
  performedByType String?      // agent, system, contact

  reason          String?

  createdAt       DateTime     @default(now())

  @@index([conversationId])
}



//──────Model autoReopen──────
model AutoReopenConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique

  enabled            Boolean  @default(true)
  reopenWindowHours  Int      @default(72)
  maxReopenCount     Int      @default(5)
  smartFilterEnabled Boolean  @default(true)

  assignmentStrategy String   @default("original_agent")
  // original_agent, unassigned_pool

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}



//──────────────────enum PlanStatus──────────────────
enum PlanStatus {
  ACTIVE
  INACTIVE
}



//──────────────────Model SubscriptionPlan──────────────────
model SubscriptionPlan {
  id           String     @id @default(cuid())
  name         String     @unique
  description  String?

  monthlyPrice Float
  annualPrice  Float?

  status       PlanStatus @default(ACTIVE)
  isPopular    Boolean    @default(false)

  // ─── Usage Limits (null = unlimited) ───
  maxAgents      Int
  maxBroadcasts  Int?
  maxAutomations Int?
  maxCampaigns   Int?
  maxApiCalls    Int?
  maxAiCredits   Int?

  // ─── Relations ───
  features     PlanFeature[]
  integrations PlanIntegration[]
  tenants      Tenant[]   @relation("TenantSubscription")

  // ─── Timestamps ───
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}



//──────────────────Model Feature──────────────────
model Feature {
  id    String @id @default(cuid())
  name  String @unique

  // ─── Relations ───
  plans PlanFeature[]

  // ─── Timestamps ───
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



//──────────────────Plan ↔ Feature Mapping──────────────────
model PlanFeature {
  id        String           @id @default(cuid())

  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  featureId String
  feature   Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
}



//──────────────────Model PlanIntegration──────────────────
model PlanIntegration {
  id     String           @id @default(cuid())
  name   String

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planId, name])
  @@index([planId])
}


//──────────────────Model Payment──────────────────
model Payment {
  id          String   @id @default(cuid())
  tenantId    String

  // Razorpay Details
  razorpayOrderId    String   @unique
  razorpayPaymentId  String?  @unique
  razorpaySignature  String?

  // Plan snapshot at time of payment
  planId       String
  planName     String
  billingType  String   // monthly / annual

  // Amount Breakdown
  baseAmount   Float
  gstPercent   Float    @default(18)
  gstAmount    Float
  totalAmount  Float
  currency     String   @default("INR")

  // Payment Meta
  paymentMethod  String?   // card / upi / netbanking
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoiceUrl    String? 

  @@index([tenantId])
  @@index([status])

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}



enum TemplateHeaderType {
  NONE
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  LOCATION
}

enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT           // Created locally, not submitted to Meta
  PENDING         // Submitted to Meta, awaiting review
  APPROVED        // Approved by Meta, ready to use
  REJECTED        // Rejected by Meta
  PAUSED          // Paused by Meta (quality issues)
  DISABLED        // Disabled by Meta
  DELETED         // Soft deleted
}

enum BroadcastTarget {
  ALL
  TAGS
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PROCESSING     // Currently sending
  PAUSED         // Manually paused mid-send
  COMPLETED      // All messages attempted
  CANCELLED
  FAILED         // System error
}

enum MessageStatus {
  PENDING         // Not yet sent to Meta
  SENT            // Accepted by Meta API
  DELIVERED       // Delivered to user's phone
  READ            // User opened/read
  FAILED          // Failed to send
}

// ============================================
// TEMPLATE MANAGEMENT
// ============================================

model Template {
  id              String           @id @default(cuid())
  
  // Multi-tenancy
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  
  // Meta-synced fields
  metaTemplateId  String?          @unique  // ID returned by Meta after approval
  name            String           // must be lowercase, underscores only for Meta
  language        String           @default("en_US")
  category        TemplateCategory
  status          TemplateStatus   @default(DRAFT)
  
  // Template structure
  components      Json             // Full Meta components array: body text, headers, buttons

  // ── Header fields (typed for querying, validation, and send-time use) ──
  headerType            TemplateHeaderType @default(NONE)
  headerText            String?            // TEXT header content (max 60 chars per Meta)
  headerMediaUrl        String?            // local file path for IMAGE / VIDEO / DOCUMENT
  headerMediaHandle     String?            // Meta resumable-upload handle (used at send time)
  headerLocationName    String?            // default location name (LOCATION templates)
  headerLocationAddress String?            // default location address (LOCATION templates)
  headerLocationLat     Float?             // default latitude  (-90 … 90)
  headerLocationLng     Float?             // default longitude (-180 … 180)

  // ── Footer & Buttons ──
  footerText      String?            // FOOTER component text (max 60 chars per Meta)
  buttons         Json?              // BUTTONS component array (Meta structure)

  // Parameter metadata (for UI rendering)
  headerParams    Int              @default(0)  // count of {{n}} in header
  bodyParams      Int              @default(0)  // count of {{n}} in body
  
  // Meta rejection reason
  rejectedReason  String?
  
  // Quality tracking
  qualityScore    String?          // GREEN, YELLOW, RED from Meta
  
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastSyncedAt    DateTime?

  broadcasts      Broadcast[]
  
  @@unique([name, language, tenantId])  // Meta requires unique name+language, unique per tenant
  @@index([status])
  @@index([category])
  @@index([tenantId])
}

// ============================================
// BROADCAST CAMPAIGNS
// ============================================

model Broadcast {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  name            String           // Campaign name: "Diwali Sale 2024"
  
  // Template reference
  templateId      String
  template        Template         @relation(fields: [templateId], references: [id])
  
  // Targeting
  targetType      BroadcastTarget  // ALL or TAGS
  tags            BroadcastTag[]   // Only used if targetType = TAGS
  
  // Default parameters (can be overridden per recipient)
  defaultParams   Json?
  
  // Campaign status
  status          BroadcastStatus  @default(DRAFT)
  
  // Scheduling
  scheduledAt     DateTime?        // null = send immediately
  startedAt       DateTime?
  completedAt     DateTime?
  
  // Stats (denormalized for fast queries)
  totalRecipients Int              @default(0)
  sent            Int              @default(0)
  delivered       Int              @default(0)
  read            Int              @default(0)
  failed          Int              @default(0)
  
  // Rate limiting
  batchSize       Int              @default(50)   // messages per batch
  batchDelayMs    Int              @default(1000)  // delay between batches
  
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  recipients      BroadcastRecipient[]
  
  @@index([status])
  @@index([scheduledAt])
  @@index([createdById])
  @@index([tenantId])
}

model BroadcastTag {
  broadcastId String
  tagId       String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id])
  
  @@id([broadcastId, tagId])
}

model BroadcastRecipient {
  id            String          @id @default(cuid())
  
  broadcastId   String
  broadcast     Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  
  contactId     String
  contact       Contact         @relation(fields: [contactId], references: [id])
  
  // Per-recipient custom parameters override
  params        Json?
  
  // Meta tracking
  wamid         String?         @unique  // WhatsApp Message ID from Meta
  
  // Status progression: PENDING -> SENT -> DELIVERED -> READ or FAILED
  status        MessageStatus   @default(PENDING)
  
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  errorCode     String?         // Meta error code
  errorMessage  String?         // Human-readable error
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@unique([broadcastId, contactId])  // prevent duplicate sends
  @@index([broadcastId, status])
  @@index([wamid])
  @@index([status])
}



//──────────────────Model Notification belongs to Tenant──────────────────
model Notification {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String?  // null = for tenant admin
  type           String   // new_message / contact_assigned / conversation_reopened / broadcast_completed
  title          String
  message        String
  isRead         Boolean  @default(false)
  metadata       Json?    // extra data like conversationId, contactId
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
}


//─────────────Model Notification belongs to SuperAdmin ─────────────
model SuperAdminNotification {
  id        String   @id @default(cuid())
  // NO tenantId   ← superadmin is above all tenants
  // NO userId     ← not a tenant user
  type      String   // superadmin-specific types only
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?    // tenantId, planName, amount stored HERE
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}



enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  BILLING
  TECHNICAL
  FEATURE
  GENERAL
  ACCOUNT
}

enum TicketRaisedBy {
  TENANT
  USER
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique

  title        String
  description  String

  category     TicketCategory @default(GENERAL)
  priority     TicketPriority @default(LOW)
  status       TicketStatus   @default(OPEN)

  attachmentUrl  String? 

  raisedBy     TicketRaisedBy

  // Which tenant this belongs to
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])

  // If raised by user
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])

  // Escalated to superadmin
  isEscalated  Boolean        @default(false)

  messages     TicketMessage[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([isEscalated])
}

model TicketMessage {
  id         String     @id @default(cuid())
  ticketId   String
  ticket     Ticket     @relation(fields: [ticketId], references: [id])

  message    String
  isInternal Boolean    @default(false)

  sentBy     SenderType // ← existing enum reused

  // Only one filled based on sentBy
  tenantId     String?
  userId       String?
  superAdminId String?

  createdAt  DateTime   @default(now())

  @@index([ticketId])
}



// ──────────────────────────────────────────
// CHAT AUTOMATION - MODEL
// ──────────────────────────────────────────

enum FlowNodeType {
  SEND_MESSAGE
  ASK_QUESTION
  CONDITION
  ASSIGN_AGENT
  END_FLOW
  INTERACTIVE_BUTTONS
}

enum ConversationMode {
  BOT       // bot is handling
  AGENT     // human agent handling
  QUEUED    // waiting for agent
}

// ──────────────────────────────────────────
// ADD Flow MODEL
// ──────────────────────────────────────────

model Flow {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])

  name           String
  keywords    KeywordTrigger[]
  isActive       Boolean    @default(false)
  isDefault      Boolean    @default(false)
  // isDefault = true means
  // this flow runs when no keyword matches

  nodes          FlowNode[]

  conversations  Conversation[] @relation("ConversationFlow")

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ──────────────────────────────────────────
// ADD FlowNode MODEL
// ──────────────────────────────────────────

model FlowNode {
  id          String       @id @default(cuid())

  flowId      String
  flow        Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)

  type        FlowNodeType
  // SEND_MESSAGE → just sends text
  // ASK_QUESTION → sends text + waits for reply
  // CONDITION    → checks user reply and branches
  // ASSIGN_AGENT → hands off to human
  // END_FLOW     → ends the automation

  content     String?
  // Text to send (for SEND_MESSAGE / ASK_QUESTION)

  options     Json?
  // For CONDITION node:
  // [
  //   { "value": "1", "nextNodeId": "clx..." },
  //   { "value": "2", "nextNodeId": "clx..." },
  //   { "default": true, "nextNodeId": "clx..." }
  // ]
  //
  // For ASK_QUESTION node:
  // { "saveAs": "customer_name" }
  // saves user reply as attribute

  nextNodeId  String?
  // Points to next node id
  // (used by SEND_MESSAGE and ASK_QUESTION)

  position    Json?
  // UI position: { "x": 100, "y": 200 }
  // Only for frontend flow builder display

  order       Int          @default(0)
  // order of node in flow (1,2,3...)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([flowId])
  @@index([flowId, order])
}


// ── KEYWORDTRIGGER MODEL ──
model KeywordTrigger {
  id        String   @id @default(cuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  flowId    String
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  // onDelete Cascade = if flow deleted, keywords also deleted

  keyword   String
  // "hi", "hello", "hey", "support" etc.

  category  String?
  // "greeting", "support", "sales", "order"
  // optional - just for organizing

  createdAt DateTime @default(now())

  @@unique([tenantId, keyword])
  // Same keyword cannot be used in
  // two different flows of same tenant

  @@index([tenantId])
  @@index([flowId])
  @@index([tenantId, keyword])
}


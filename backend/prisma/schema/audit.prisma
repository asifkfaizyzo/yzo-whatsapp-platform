// backend/prisma/schema/audit.prisma (do not remove this comment)
// Audit log system — tracks all significant actions across the platform

model AuditLog {
  id          String   @id @default(cuid())

  // ── WHO did it ──
  actorId     String
  actorType   SenderType
  actorName   String
  actorEmail  String

  // ── WHAT they did ──
  action      AuditAction
  module      AuditModule
  description String

  // ── ON WHAT (target) ──
  targetId    String?
  targetType  String?
  targetName  String?

  // ── WHERE from ──
  ipAddress   String?
  userAgent   String?

  // ── EXTRA DATA ──
  metadata    Json?

  // ── SCOPE ──
  tenantId    String?
  tenant      Tenant?  @relation("TenantAuditLogs", fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([actorType])
  @@index([action])
  @@index([module])
  @@index([tenantId])
  @@index([createdAt])
  @@index([actorType, createdAt])
  @@index([tenantId,  createdAt])
  @@index([module,    action])
  @@map("audit_logs")
}
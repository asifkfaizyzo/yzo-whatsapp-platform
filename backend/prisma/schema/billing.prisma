// backend/prisma/schema/billing.prisma (do not remove this comment)
// Subscription plans, entitlements, add-ons, usage metering, payments, invoices, billing lifecycle

// ─────────────────────────────────────────────
// SubscriptionPlan — V2 dynamic entitlement plans
// ─────────────────────────────────────────────
model SubscriptionPlan {
  id                      String         @id @default(cuid())
  name                    String         @unique
  description             String?        @db.Text

  status                  PlanStatus     @default(ACTIVE)
  planType                String         @default("REGULAR") // REGULAR | CUSTOM | PROMO
  visibility              PlanVisibility @default(PUBLIC)
  sortOrder               Int            @default(0)
  badgeText               String?
  customTenantId          String?        // set only when planType = CUSTOM

  // Pricing (null cycle price = cycle not offered)
  monthlyPrice            Float          @default(0)
  quarterlyPrice          Float?
  annualPrice             Float?
  originalPrice           Float?         // strikethrough price for promos
  offerValidUntil         DateTime?

  // Trial
  hasTrial                Boolean        @default(false)
  trialDays               Int            @default(14)
  trialRequiresCard       Boolean        @default(false)

  // Razorpay plan IDs — nulled on price change, lazily recreated
  razorpayMonthlyPlanId   String?
  razorpayQuarterlyPlanId String?
  razorpayAnnualPlanId    String?

  // Dynamic entitlements — validated against backend/src/lib/entitlements/registry.js
  // INT: -1 = unlimited, 0 = blocked, absent key = registry default
  entitlements            Json           @default("{}")

  tenantSubscriptions     TenantSubscription[] @relation("CurrentPlan")
  pendingSubscriptions    TenantSubscription[] @relation("PendingPlan") // scheduled plan changes targeting this plan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([planType])
  @@map("subscription_plans")
}

// ─────────────────────────────────────────────
// TenantSubscription — platform subscription + merchant gateway
// NOTE: merchant Razorpay sections (keys, OAuth, KYC) are the tenant's
// OWN payment-collection config — unrelated to plan billing. Untouched.
// Grace period = subscriptionStatus "payment_failed" + gracePeriodEnd in future.
// ─────────────────────────────────────────────
model TenantSubscription {
  tenantId             String              @id @unique
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Plan
  planId               String?
  plan                 SubscriptionPlan?   @relation("CurrentPlan", fields: [planId], references: [id])
  planActivatedAt      DateTime?
  billingCycle         BillingCycle        @default(MONTHLY)
  currentPlan          String?             // plan name snapshot for emails/display

  // Scheduled plan change: applied at planPeriodEnd (no proration).
  // Cleared when applied, cancelled by the tenant, or the subscription expires.
  pendingPlanId        String?
  pendingPlan          SubscriptionPlan?   @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  pendingBillingCycle  BillingCycle?

  // Lifecycle
  subscriptionStatus   SubscriptionStatus  @default(expired)
  planPeriodStart      DateTime?
  planPeriodEnd        DateTime?
  cancelRequestedAt    DateTime?
  cancellationReason   String?
  reactivatedAt        DateTime?
  freeUntilDate        DateTime?           // admin-granted free access until date
  dataDeletionDate     DateTime?

  // Grace period & debt
  gracePeriodDays      Int?                // per-tenant override; null = PlatformSettings.defaultGraceDays
  gracePeriodEnd       DateTime?
  graceDebtDays        Int                 @default(0)
  graceDebtPlanPrice   Float?              // monthly-equivalent price snapshot at block time

  // SuperAdmin per-tenant entitlement overrides
  customLimitsOverride Json?               @default("{}")

  // Platform billing (how tenant pays US)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?   @unique
  autopayEnabled         Boolean   @default(false)
  autopayMethod          String?

  // Merchant gateway (how tenant collects from THEIR customers) — UNCHANGED
  razorpayKeyId          String?
  razorpayKeySecret      String?
  razorpayWebhookSecret  String?
  enableOnlinePayment    Boolean   @default(false)
  enableCod              Boolean   @default(true)
  defaultCurrency        String    @default("INR")
  paymentLinkExpiryMins  Int       @default(30)
  autoConfirmOnPayment   Boolean   @default(true)

  // Razorpay Partner OAuth — UNCHANGED
  razorpayAuthType       RazorpayAuthType      @default(DIRECT_KEYS)
  razorpayAccountId      String?
  razorpayAccessToken    String?
  razorpayRefreshToken   String?
  razorpayTokenExpiresAt DateTime?
  razorpayWebhookId      String?
  razorpayAccountStatus  RazorpayAccountStatus @default(DISCONNECTED)
  razorpayKycStatus      RazorpayKycStatus     @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([razorpayAccountId])
  @@index([planId])
  @@index([pendingPlanId])
  @@index([subscriptionStatus])
  @@map("tenant_subscription")
}

// ─────────────────────────────────────────────
// TenantUsage — per-cycle metering + top-up bonus pool
// ─────────────────────────────────────────────
model TenantUsage {
  id          String   @id @default(cuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  key         String   // entitlement key (e.g. "maxBroadcasts")
  used        Int      @default(0)
  bonus       Int      @default(0) // from one-time top-ups; survives cycle rollover

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd, key])
  @@index([tenantId, key])
  @@map("tenant_usages")
}

// ─────────────────────────────────────────────
// PlanAddOn — purchasable entitlement boosters (admin-created, no seed)
// ─────────────────────────────────────────────
model PlanAddOn {
  id               String       @id @default(cuid())
  name             String
  key              String       @unique
  description      String?      @db.Text
  type             AddOnType    @default(RECURRING)
  billingCycle     BillingCycle @default(MONTHLY)
  price            Float
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)

  // Entitlement payload — entitlementKey must exist in lib/entitlements/registry.js
  entitlementKey   String
  entitlementValue Json         // INT increment (e.g. 5000) or true (boolean)

  razorpayPlanId   String?

  tenantAddOns     TenantAddOn[]
  payments         Payment[]
  invoices         Invoice[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([isActive])
  @@map("plan_add_ons")
}

// ─────────────────────────────────────────────
// TenantAddOn — a tenant's purchased add-on (independent cycle)
// ─────────────────────────────────────────────
model TenantAddOn {
  id                     String       @id @default(cuid())
  tenantId               String
  addOnId                String
  status                 String       @default("active") // active | cancelled | expired
  source                 String       @default("PURCHASE") // PURCHASE | ADMIN_GRANT
  quantity               Int          @default(1)
  startsAt               DateTime     @default(now())
  expiresAt              DateTime?
  razorpaySubscriptionId String?      @unique

  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addOn                  PlanAddOn    @relation(fields: [addOnId], references: [id])

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([tenantId, status])
  @@map("tenant_add_ons")
}

// ─────────────────────────────────────────────
// TrialEmailRegistry — one trial per email, EVER.
// Survives tenant deletion. Never cascade-deleted.
// ─────────────────────────────────────────────
model TrialEmailRegistry {
  id        String   @id @default(cuid())
  email     String   @unique
  usedAt    DateTime @default(now())

  @@map("trial_email_registry")
}

// ─────────────────────────────────────────────
// Payment — now covers plans, add-ons, and top-ups
// ─────────────────────────────────────────────
model Payment {
  id          String   @id @default(cuid())
  tenantId    String

  razorpayOrderId    String?
  razorpayPaymentId  String?  @unique
  razorpaySignature  String?

  paymentType        String   @default("ONLINE")
  offlineReference   String?

  // What was purchased
  purchaseType String     @default("PLAN") // PLAN | ADDON | TOPUP
  planId       String?                     // plain string reference (no FK) — set when PLAN
  addOnId      String?
  addOn        PlanAddOn? @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  planName     String
  billingType  String

  baseAmount   Float
  gstPercent   Float    @default(18)
  gstAmount    Float
  totalAmount  Float
  currency     String   @default("INR")

  paymentMethod  String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoiceUrl    String?

  @@index([tenantId])
  @@index([status])
  @@index([offlineReference])
  @@index([addOnId])

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice?

  @@map("payments")
}

// ─────────────────────────────────────────────
// Invoice
// ─────────────────────────────────────────────
model Invoice {
  id                   String        @id @default(uuid())
  tenantId             String
  invoiceNumber        String        @unique

  purchaseType         String        @default("PLAN") // PLAN | ADDON | TOPUP
  addOnId              String?
  addOn                PlanAddOn?    @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  planName             String
  amount               Decimal       @db.Decimal(10, 2)
  billingCycle         BillingCycle? // PLAN: plan cycle | ADDON: add-on cycle | TOPUP: ONE_TIME
  paymentId            String?       @unique
  payment              Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  baseAmount           Decimal?      @db.Decimal(10, 2)
  gstEnabled           Boolean       @default(true)
  gstPercent           Float?        @default(18)
  gstAmount            Decimal?      @db.Decimal(10, 2)
  gstType              String?       @default("CGST_SGST")

  currency             String        @default("INR")
  status               InvoiceStatus @default(paid)
  billingPeriodStart   DateTime
  billingPeriodEnd     DateTime
  paymentMethodLast4   String?
  paymentMethodBrand   String?
  offlineReference     String?
  pdfUrl               String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenant               Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([addOnId])
  @@map("invoices")
}

model SubscriptionReminder {
  id           String   @id @default(uuid())
  tenantId     String
  reminderType String
  sentAt       DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@map("subscription_reminders")
}

model CancellationSurvey {
  id                   String              @id @default(uuid())
  tenantId             String              @unique
  reason               CancellationReason
  additionalComment    String?
  createdAt            DateTime            @default(now())
  tenant               Tenant              @relation(fields: [tenantId], references: [id])

  @@map("cancellation_surveys")
}

model TenantDataDeletion {
  id                   String    @id @default(uuid())
  tenantId             String
  deletedAt            DateTime  @default(now())
  deletedBy            String    @default("system")
  note                 String?
  tenant               Tenant    @relation(fields: [tenantId], references: [id])

  @@map("tenant_data_deletions")
}


// Perpetual top-up / bonus credits. Never reset monthly; consumed only after the
// plan's monthly base quota is spent (see lib/entitlements/usage.service.js).
model TenantCreditPool {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  granted   Int      @default(0)
  consumed  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("tenant_credit_pools")
}
// backend/prisma/schema/quick-replies.prisma (do not remove this comment)
// Quick replies / canned responses for agents

model QuickReply {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  shortcut       String
  title          String
  content        String               @db.Text
  category       String               @default("General")

  scope          QuickReplyScope      @default(GLOBAL)
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByType  String               @default("TENANT")
  createdByName  String?

  mediaUrl       String?
  mediaName      String?
  mediaSize      Int?
  mediaMimeType  String?
  mediaType      QuickReplyMediaType?

  isActive       Boolean              @default(true)
  usageCount     Int                  @default(0)
  lastUsedAt     DateTime?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([tenantId, shortcut])
  @@index([tenantId, category])
  @@index([tenantId, scope, isActive])
  @@index([userId])
  @@map("quick_replies")
}
// backend/prisma/tenant.prisma (do not remove this comment)

model Tenant {
  id          String   @id @default(cuid())
  tenantName  String?
  email       String?  @unique
  username    String    @unique   
  password    String?
  resetToken       String?
  resetTokenExpiry DateTime?
  phone       String?
  address     String?
  firstName   String?
  lastName    String?
  websiteUrl  String?
  industry    String?
  companySize String?
  country     String?
  useCase     String?
  logo        String?
  deletedAt        DateTime?
  otpAttempts      Int       @default(0)
  isEmailVerified  Boolean   @default(false)
  otpHash          String?
  otpExpiresAt     DateTime?
  authProvider     String    @default("LOCAL")
  googleId         String?   @unique
  facebookId       String?   @unique
  timezone    String?  @default("Asia/Kolkata")
  status      TenantStatus @default(PENDING)
  isActive    Boolean  @default(true)
  onboardingStep      Int     @default(1)
  onboardingCompleted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── 1:1 Related Tables ──
  auth         TenantAuth?
  whatsapp     TenantWhatsApp?
  social       TenantSocial?
  zoho         TenantZoho?
  subscription TenantSubscription?

  // ── 1:N Relations (unchanged) ──
  refreshTokens     RefreshToken[]
  tags              Tag[]
  userTagMappings   UserTagMapping[]
  users             User[]
  contacts          Contact[]
  orders            Order[]
  templates         Template[]
  broadcasts        Broadcast[]
  payments          Payment[]
  tickets           Ticket[]
  flows             Flow[]
  keywordTriggers   KeywordTrigger[]
  enterpriseLeads   EnterpriseLead[]
  quickReplies      QuickReply[]
  subscriptionReminders SubscriptionReminder[]
  invoices          Invoice[]
  cancellationSurvey    CancellationSurvey?
  dataDeletions         TenantDataDeletion[]
  auditLogs         AuditLog[] @relation("TenantAuditLogs")
  googleSheetConnection GoogleSheetConnection?
  sheetFields           SheetField[]
  shopifyConnection     ShopifyConnection?
  shopifyProducts       ShopifyProduct[]
  woocommerceConnection WooCommerceConnection?
  ecommerceOrders       EcommerceOrder[]
  botFaqs               BotFaq[]

  @@index([status])
  @@map("tenants")
}

// ─────────────────────────────────────────────
// Auth — login providers, email verification, OTP
// ─────────────────────────────────────────────
model TenantAuth {
  tenantId       String    @id @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googleId       String?   @unique
  facebookId     String?   @unique
  authProvider   String    @default("LOCAL")
  isEmailVerified Boolean  @default(false)
  otpHash        String?
  otpExpiresAt   DateTime?

  @@map("tenant_auth")
}

// ─────────────────────────────────────────────
// WhatsApp — Meta Business API credentials
// ─────────────────────────────────────────────
model TenantWhatsApp {
  tenantId            String  @id @unique
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappPhoneId     String?
  whatsappWabaId      String?
  whatsappAccessToken String?
  whatsappVerifyToken String? @default("yzo_default_verification_token")
  whatsappPin         String?
  whatsappCatalogId   String?

  @@index([whatsappPhoneId])
  @@map("tenant_whatsapp")
}

// ─────────────────────────────────────────────
// Social — Facebook & Instagram integration
// ─────────────────────────────────────────────
model TenantSocial {
  tenantId                String  @id @unique
  tenant                  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facebookPageId          String?
  facebookPageName        String?
  facebookPageAccessToken String?
  instagramAccountId      String?
  instagramUsername       String?

  @@map("tenant_social")
}

// ─────────────────────────────────────────────
// Zoho — CRM integration credentials
// ─────────────────────────────────────────────
model TenantZoho {
  tenantId             String               @id @unique
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zohoAccessToken      String?
  zohoRefreshToken     String?
  zohoTokenExpiresAt   DateTime?
  zohoAccountId        String?
  zohoDataCenter       String?
  zohoApiDomain        String?
  zohoAccountEmail     String?
  zohoConnectionStatus ZohoConnectionStatus  @default(DISCONNECTED)
  zohoConnectedAt      DateTime?
  zohoScopes           String?

  @@map("tenant_zoho")
}

// ─────────────────────────────────────────────
// Subscription — plan, billing, Razorpay (platform + merchant)
// ─────────────────────────────────────────────
model TenantSubscription {
  tenantId             String                @id @unique
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Plan
  planId               String?
  plan                 SubscriptionPlan?     @relation("SubscriptionPlanLink", fields: [planId], references: [id])
  planActivatedAt      DateTime?
  billingType          String?               @default("monthly")
  planStatus           String?               @default("inactive")

  // Subscription lifecycle
  subscriptionStatus   SubscriptionStatus    @default(trialing)
  currentPlan          String?
  planPeriodStart      DateTime?
  planPeriodEnd        DateTime?
  cancelRequestedAt    DateTime?
  cancellationReason   String?
  reactivatedAt        DateTime?
  dataDeletionDate     DateTime?

  // Trial
  hasUsedTrial         Boolean   @default(false)
  trialPlanId          String?
  trialExtendedCount   Int       @default(0)
  trialExtendedByAdmin String?

  // Platform billing (how tenant pays US)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?   @unique
  autopayEnabled         Boolean   @default(false)
  autopayMethod          String?

  // Merchant gateway (how tenant collects from THEIR customers)
  razorpayKeyId          String?
  razorpayKeySecret      String?
  razorpayWebhookSecret  String?
  enableOnlinePayment    Boolean   @default(false)
  enableCod              Boolean   @default(true)
  defaultCurrency        String    @default("INR")
  paymentLinkExpiryMins  Int       @default(30)
  autoConfirmOnPayment   Boolean   @default(true)

  // Razorpay Partner OAuth
  razorpayAuthType       RazorpayAuthType      @default(DIRECT_KEYS)
  razorpayAccountId      String?
  razorpayAccessToken    String?
  razorpayRefreshToken   String?
  razorpayTokenExpiresAt DateTime?
  razorpayWebhookId      String?
  razorpayAccountStatus  RazorpayAccountStatus @default(DISCONNECTED)
  razorpayKycStatus      RazorpayKycStatus     @default(PENDING)

  @@index([razorpayAccountId])
  @@map("tenant_subscription")
}
{
  "expo": {
    "name": "Sudo Reply",
    "slug": "sudo-reply-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#125EF2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sudoreply.mobile",
      "infoPlist": {
        "NSContactsUsageDescription": "Sudo Reply needs access to your contacts to import them into your CRM."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#125EF2"
      },
      "package": "com.sudoreply.mobile",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.100:5000"
    }
  }
}
